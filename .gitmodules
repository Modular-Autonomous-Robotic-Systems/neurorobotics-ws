	branch = master
[submodule "ext/calibration/kalibr"]
	path = ext/calibration/kalibr
	url = git@github.com:ethz-asl/kalibr.git
[submodule "ext/calibration/allan_variance_ros"]
	path = ext/calibration/allan_variance_ros
	url = git@github.com:ori-drs/allan_variance_ros.git
[submodule "docker/ardupilot/ardupilot_dev_docker"]
	path = docker/ardupilot/ardupilot_dev_docker
