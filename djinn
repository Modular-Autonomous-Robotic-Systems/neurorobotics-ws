#!/bin/bash

# data.sh declares all variables and data required for djinn and its derivative scripts
# available variables are
# 1. config_file
# 2. statefile
# 3. last_run_sitl_env
# available methods are
# 1. save_state
source $NRT_WS/scripts/helpers/data.sh
# exec.sh declares all execution functions required for djinn and its derivative scripts
# available methods are
# 1. iexec
# 2. iexec_ros
# 3. iexec_kalibr
# 4. iexec_sitl
# 5. iexec_sitl
# 6. terminate_process
source $NRT_WS/scripts/helpers/exec.sh
# docker.sh declares all helper functions related to docker required for djinn and its derivative scripts
# available methods are
# 1. build_image
# 2. setup_nvim_config_for_image_build
# 3. cleanup_nvim_config_after_image_build
# 4. spawn_container_if_needed
source $NRT_WS/scripts/helpers/docker.sh
# sitl.sh declares all helper functions required for djinn and its derivative scripts
# available methods are
# 1. build_sitl_docker_image
# 2. build_sitl_docker_image
# 3. start_simulation
# 4. start_sitl_container
source $NRT_WS/scripts/helpers/sitl.sh
# ai.sh declares directive-sync helper functions required for djinn
# available methods are
# 1. sync_directive_pair
source $NRT_WS/scripts/helpers/ai.sh

cd $NRT_WS

if [[ "$1" == "install" ]]; then
    scripts/install.sh $2 $3 $4

elif [[ "$1" == "init" ]]; then
    if [[ ! -d ".ssh" ]]; then
        read -p "Enter email address for github: " email
        read -p "Enter username for dockerhub: " name
        echo "VERSION=0.0.9" >>$config_file
        echo "ROS_VERSION=\"humble\"" >>$config_file
        echo "userEmail="$email >>$config_file
        echo "userName="$name >>$config_file
        if [[ -d "$HOME/.ssh" && ! -L "${HOME}/.ssh" ]]; then
            cp -r "$HOME/.ssh" $NRT_WS/.ssh
        else
            mkdir .ssh
            cd .ssh
            ssh-keygen -q -t rsa -C "$email" -N "" -f id_rsa <<<y >/dev/null 2>&1
            cd -
        fi
    fi
    export $(grep -v '^#' $config_file | xargs)
    echo "Github Email: $userEmail"
    echo "Dockerhub ID: $userName"
    if [[ "$2" == "docker" ]]; then
        platform="linux/amd64,linux/arm64"
        mode="base"
        echo "$3"
        if [[ -n "$3" ]]; then
            echo "============ BUILDING Image ============="
            if [[ "$3" == "nrt" ]]; then
                # echo "============ BUILDING Base Image ============="
                image="$userName/nrt:base"
                filepath="$NRT_WS/docker/base/"
                setup_nvim_config_for_image_build $filepath
                build_image $platform $image $filepath
                cleanup_nvim_config_after_image_build $filepath
                echo "============ BUILDING ROS Image ============="
                image="$userName/nrt:ros"
                filepath="$NRT_WS/docker/ros"
                platform="linux/amd64,linux/arm64"
                build_image $platform $image $filepath
                echo "============ BUILDING NRT Pangolin Image ============="
                image="$userName/nrt:pangolin"
                filepath="$NRT_WS/docker/pangolin"
                platform="linux/amd64,linux/arm64"
                build_image $platform $image $filepath
                echo "============ BUILDING NRT Camera Image ============="
                image="$userName/nrt:camera"
                filepath="$NRT_WS/docker/camera"
                platform="linux/amd64,linux/arm64"
                build_image $platform $image $filepath
                echo "============ BUILDING NRT VERSION:$VERSION Image ============="
                # docker stop init_container && docker rm init_container
                # setup_airsim_ros_pkgs_for_docker_build "ardupilot"
                image="$userName/nrt:$VERSION"
                filepath="$NRT_WS/docker/ardupilot"
                platform="linux/amd64,linux/arm64"
                build_image $platform $image $filepath
                spawn_container_if_needed init_container shandilya1998/nrt:$VERSION
                # init_container was spawned in setup_airsim_ros_pkgs_for_docker_build
                # iexec init_container "rm -rf /ws/docker/ardupilot/airsim_ws"
                docker stop init_container
                docker rm init_container
            elif [[ "$3" == "dev" ]]; then
                image="$userName/nrt:dev"
                filepath="$NRT_WS/docker/dev/"
                build_image $platform $image $filepath
                docker pull $image
                mkdir -p $NRT_WS/.claude $NRT_WS/.gemini $NRT_WS/.claude/skills
                if [[ ! -f $NRT_WS/.claude.json ]]; then
                    touch $NRT_WS/.claude.json
                fi
                source $NRT_WS/docker/scripts/start_ide.sh init_container $image
                iexec init_container "ln -sfn /ws/skills/nrt-RandD-workflow /ws/.claude/skills/nrt-RandD-workflow"
                # $4 protects the git/submodule step: pass skip-git-setup, on for a routine image refresh;
                # pass any other value, e.g. init-git-setup or omit the argument to ensure git setup is performed
                iexec init_container "source /ws/scripts/git-setup.sh $userEmail $userName"
                if [[ -n "$4" ]]; then
                    if [[ "$4" == "skip-git-setup" ]]; then
                        echo "skipping git submodule setup"
                    else
                        iexec init_container "source /ws/scripts/docker-setup.sh"
                    fi
                else
                    iexec init_container "source /ws/scripts/docker-setup.sh"
                fi
                iexec init_container "source /ws/scripts/helpers/ai.sh && \
                    sync_directive_pair /ws && \
                    if [ -f /ws/.gitmodules ]; then \
                        while IFS= read -r sm_path; do \
                            [ -d \"/ws/\$sm_path\" ] && sync_directive_pair \"/ws/\$sm_path\"; \
                        done < <(git config --file /ws/.gitmodules --get-regexp '\.path\$' | awk '{print \$2}'); \
                    fi"
                iexec init_container "claude /login"
                iexec init_container "agy -p '/usage'"
                source $NRT_WS/docker/dev/install_nerd_font.sh
                docker stop init_container
                docker rm init_container
            elif [[ "$3" == "airsim" ]]; then
                echo "============ BUILDING SIMULATION Image ============="
                build_airsim_docker_image
            elif [[ "$3" == "sitl" ]]; then
                # This step assumes that `djinn init docker nrt` has been run
                echo "============ BUILDING SIMULATION Image ============="
                build_airsim_docker_image
                echo "============ BUILDING SITL BRIDGE Image ============="
                image="$userName/nrt:$VERSION"
                filepath="$NRT_WS/docker/ardupilot"
                platform="linux/amd64,linux/arm64"
                build_image $platform $image $filepath
                # init_container was spawned in setup_airsim_ros_pkgs_for_docker_build
                if [[ ! -f "ext/QGroundControl.AppImage" ]]; then
                    echo "============ Fetching QGroundControl ============="
                    iexec init_container "wget https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl.AppImage -O /ws/ext/QGroundControl.AppImage"
                    iexec init_container "chmod +x /ws/ext/QGroundControl.AppImage"
                else
                    echo "============ Not Fetching QGroundControl. It Exists. ============="
                fi
                docker stop init_container
            elif [[ "$3" == "kalibr" ]]; then
                echo "============ BUILDING Kalibr Image ============="
                image="$userName/nrt:kalibr"
                filepath="$NRT_WS/ext/calibration/kalibr/"
                container_name="kalibr_container"
                mode="kalibr"
                build_image $platform $image $filepath "NRT_WS=$NRT_WS"
            fi
        fi
    fi

elif [[ "$1" == "up" ]]; then
    mode="ros"
    export $(grep -v '^#' $config_file | xargs)
    echo "username: $userName"
    echo "email: $userEmail"
    # git submodule update --init --recursive
    if [[ -n "$2" ]]; then

        if [[ "$2" == "nrt" ]]; then
            echo "=============== Initialising NRT Base Container ================"
            spawn_container_if_needed nrt_container shandilya1998/nrt:$VERSION
            iexec_ros nrt_container "ls && echo \"Starting Container Setup\" && /ws/scripts/git-setup.sh $userEmail $userName"
            iexec_ros nrt_container "/ws/scripts/build_ros_packages.sh"
        elif [[ "$2" == "dev" ]]; then
            echo "=============== Initialising NRT Development Container ================"
            spawn_container_if_needed dev_container shandilya1998/nrt:dev
            iexec dev_container "ls && echo \"Starting Container Setup\" && /ws/scripts/git-setup.sh $userEmail $userName"
            # TODO add a link to the IDE Cheatsheet in the README.md with the repository
        elif [[ "$2" == "airsim" ]]; then
            if [[ -n "$3" ]]; then
                start_simulation $3
            else
                start_simulation "nature"
            fi
        elif [[ "$2" == "sitl_bridge" ]]; then
            spawn_container_if_needed sitl_bridge_container shandilya1998/nrt:$VERSION
            iexec_ros sitl_bridge_container "source /ws/ardu_ws/scripts/build.sh"
            iexec_ros sitl_bridge_container "source /ws/sitl_ws/scripts/build.sh"
        elif [[ "$2" == "kalibr" ]]; then
            echo "============ Initialising Kalibr Container ============="
            source $NRT_WS/scripts/start.sh $NRT_WS kalibr_container shandilya1998/nrt:kalibr
        fi
    else
        source $NRT_WS/scripts/start.sh $NRT_WS nrt_container shandilya1998/nrt:$VERSION
        iexec_ros nrt_container "ls && echo \"Starting Container Setup\" && /ws/scripts/git-setup.sh $userEmail $userName"
        iexec_ros nrt_container "./scripts/build.sh && ./scripts/build_ros_packages.sh && cd ros_ws && source install/local_setup.bash && cd .."
    fi

elif [[ "$1" == "build" ]]; then
    clear
    if [[ -z "$2" ]]; then
        echo "=========== BUILDING NRT And related Packages ==========="

        iexec_ros nrt_container "./scripts/build.sh && ./scripts/build_ros_packages.sh && cd ros_ws && source install/local_setup.bash && cd .."
    else
        if [[ "$2" == "nrt" ]]; then
            echo "=========== BUILDING Packages ==========="
            echo $PWD
            iexec_ros nrt_container "./scripts/build_ros_packages.sh"
        elif [[ "$2" == "docker" ]]; then
            image="$3"
            filepath="$4"
            platform="linux/amd64,linux/arm64"
            if [[ -n "$5" ]]; then
                if [[ "$5" == "aarch64" ]]; then
                    platform="linux/arm64"
                elif [[ "$5" == "x86_64" ]]; then
                    platform="linux/amd64"
                elif [[ "$5" == "all" ]]; then
                    platform="linux/amd64,linux/arm64"
                else
                    echo "unsupported platform"
                    cd $WS_PATH
                    exit
                fi
            fi
            # build_image $platform $image $filepath "NRT_WS=$NRT_WS"
            source $NRT_WS/docker/scripts/docker-build.sh $platform $image $filepath "NRT_WS=$NRT_WS"
        elif [[ "$2" == "ardupilot" ]]; then
            spawn_container_if_needed sitl_bridge_container "shandilya1998/nrt:$VERSION"
            board="SpeedyBeeF405WING"
            configuration="plane"
            if [[ ! -z "$3" ]]; then
                board="$3"
            fi
            if [[ ! -z "$4" ]]; then
                configuration="$4"
            fi
            iexec_sitl2 sitl_bridge_container "cd /ws/ardu_ws/src/ardupilot && ./waf configure --enable-dds --board $board && ./waf $configuration"
            iexec_sitl2 sitl_bridge_container "cp -r /ws/ardu_ws/src/ardupilot/build/$board /ws/logs/$board"
        elif [[ "$2" == "ardupilot-sitl" ]]; then
            spawn_container_if_needed sitl_bridge_container "shandilya1998/nrt:$VERSION"
            iexec_ros sitl_bridge_container "/ws/ardu_ws/scripts/build.sh"
        elif [[ "$2" == "airsim-sitl" ]]; then
            spawn_container_if_needed sitl_bridge_container "shandilya1998/nrt:$VERSION"
            iexec_ros sitl_bridge_container "/ws/sitl_ws/scripts/build.sh"
        elif [[ "$2" == "sitl" ]]; then
            spawn_container_if_needed sitl_bridge_container "shandilya1998/nrt:$VERSION"
            iexec_ros sitl_bridge_container "/ws/ardu_ws/scripts/build.sh"
            iexec_ros sitl_bridge_container "/ws/sitl_ws/scripts/build.sh"
        fi
    fi

elif [[ "$1" == "exec" ]]; then
    # djinn exec "cd ros_ws/src/ && ros2 pkg create --build-type ament_cmake Sensors" for creating ros2 packages
    # echo "${2}_container"
    if [[ "$2" == "nrt" ]]; then
        iexec_ros "${2}_container" $3
    else
        iexec "${2}_container" "$3"
    fi

elif [[ "$1" == "start" ]]; then
    if [[ "$2" == "tello" ]]; then
        iexec_ros nrt_container "source /ws/ros_ws/install/setup.bash && ros2 launch controllers tello_launch.py"
    elif [[ "$2" == "tello-orbslam3" ]]; then
        iexec_ros nrt_container "source /ws/ros_ws/install/setup.bash && ros2 launch controllers tello_orbslam3_mono_launch.py"
    elif [[ "$2" == "sitl" ]]; then
        if [[ -n "$3" ]]; then
            if [[ "$3" == "orbslam3" ]]; then
                # TODO add launch file here
                echo "Starting ORBSLAM3"
                spawn_container_if_needed nrt_container "shandilya1998/nrt:$VERSION"
                iexec_sitl2 nrt_container "export DISPLAY=:1 && ros2 launch slam orbslam3.launch.py log-level:=INFO camera-topic:=/airsim_node/Copter/front_center_Scene/image settings-file-path:=/ws/ros_ws/src/slam/orb_slam3/config/Monocular/sitl.yaml vocab-file-path:=/ws/ros_ws/src/slam/orb_slam3/Vocabulary/ORBvoc.txt.bin"
                iexec nrt_container "ps -eawf | grep orbslam3 | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
            elif [[ "$3" == "basalt" ]]; then
                echo "Starting Basalt"
                spawn_container_if_needed nrt_container "shandilya1998/nrt:$VERSION"
                # SLAM only. The simulator, ffmpeg encoder and managed recorder
                # are already running from `djinn start sitl`
                iexec_sitl2 nrt_container "export DISPLAY=:1 && ros2 launch controllers basalt_slam_test.launch.py \
                    log-level:=INFO \
                    ap_status_topic_name:=/ap/status \
                    camera-topic:=/airsim_node/Copter/front_center_Scene/image \
                    calibration-file-path:=/ws/ros_ws/src/slam/ext/basalt/data/sitl_calib.json \
                    configuration-file-path:=/ws/ros_ws/src/slam/ext/basalt/data/sitl_config_vo.json \
                    slam-type:=VISLAM \
                    use-sim-time:=True \
                    use-visualisation:=True \
                    imu-topic:=/ap/imu/experimental/data"
                iexec nrt_container "ps -eawf | grep basalt | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
            else
                echo "Incorrect option for SITL application"
            fi
        else
            echo "starting sitl"
            start_simulation "nature"
            echo "Starting Ardupilot"
            spawn_container_if_needed sitl_bridge_container "shandilya1998/nrt:$VERSION"
            gnome-terminal --title "AirSim" -- bash -c "$NRT_WS/sitl_ws/scripts/run_airsim.sh;"
            sleep 3

            gnome-terminal --title "SITL Bridge" -- bash -c "$NRT_WS/ardu_ws/scripts/run_ardupilot_airsim_ros_sitl.sh; exec bash"
            gnome-terminal --title "QGroundControl" -- bash -c "$NRT_WS/ext/QGroundControl.AppImage"
        fi
        # stop_sitl_container
        # stop_simulation
    elif [[ "$2" == "ardupilot_target_recorder" ]]; then
        iexec_ros_ap "ros2 launch controllers "
    elif [[ "$2" == "basalt" ]]; then
        iexec_ros nrt_container "export DISPLAY=:1 && cd /ws/ros_ws/build/slam/ext/basalt && gdb --ex run --ex bt --ex q --args ./basalt_slam --cam-calib /ws/ros_ws/src/slam/ext/basalt/data/euroc_ds_calib.json --config-path /ws/ros_ws/src/slam/ext/basalt/data/euroc_config.json --dataset-type euroc --dataset-path /ws/ros_ws/src/slam/ext/basalt/data/machine_hall/MH_05_difficult/ --show-gui true"
    fi

elif [[ $1 == "kill" ]]; then
    echo "Killing running proceses"
    if [[ "$2" == "sitl" ]]; then
        if [[ -n "$3" ]]; then
            if [[ "$3" == "basalt" ]]; then
                iexec nrt_container "ps -ef | grep basalt_slam_node | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
                iexec nrt_container "ps -ef | grep basalt_slam_controller | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
                iexec nrt_container "ps -ef | grep basalt_slam_test.launch.py | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
                iexec nrt_container "ps -ef | grep ros2cli.daemon.daemonize | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
            fi
        else
            echo "Killing SITL processes"
            stop_sitl_container
            stop_simulation
            terminate_process "QGroundControl"
            iexec nrt_container "ps -ef | grep airsim_ros_pkgs | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
        fi
    elif [[ $2 == "airsim" ]]; then
        if [[ ! -z "$last_run_sitl_env" ]]; then
            ps -eawf | grep "$last_run_sitl_env" | grep -v grep | awk '{print $2}' | xargs -r kill -9
        fi
        iexec nrt_container "ps -eawf | grep airsim_lib | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
    elif [[ "$2" == "gqc" ]]; then
        ps -ef | grep QGroundControl | grep -v grep | awk '{print $2}' | xargs -r kill -9
    elif [[ "$2" == "orbslam3" ]]; then
        iexec nrt_container "ps -eawf | grep orbslam3 | grep -v grep | awk '{print \$2}' | xargs -r kill -9"
    fi

elif [[ "$1" == "down" ]]; then
    if [[ -n "$2" ]]; then
        if [[ "$2" == "airsim" ]]; then
            docker stop airsim_container && docker rm airsim_container
        else
            docker stop "${2}_container"
        fi
    else
        docker stop base_container nrt_container sitl_container vision_tools_container bfx_container
    fi

elif [[ "$1" == "rmi" ]]; then
    if [[ -n "$2" ]]; then
        if [[ "$2" == "all" ]]; then
            docker images | grep -v grep | tail -n +2 | awk '{print $3}' | xargs -r docker rmi -f
        else
            docker rmi -f "$2"
        fi
    fi

elif [[ "$1" == "ps" ]]; then
    docker ps

elif [[ "$1" == "search" ]]; then
    grep -inr --include \*.h \
        --include \*.cpp \
        --include \*.hpp \
        --include \*.py \
        --include \*CMakeLists.txt \
        --include \*.sh \
        --include \*package.xml "$2" \
        --include $NRT_WS/djinn -e "$3"
fi
