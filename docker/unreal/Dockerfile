# Vendored verbatim from Engine/Extras/Containers/Dockerfiles/linux/dev/Dockerfile
# of EpicGames/UnrealEngine branch 5.7, commit 0bcfaffa52e9557258dbd388835ac7668fe864a4,
# copied rather than submoduled because the build context is these five files and
# the engine source is cloned inside the image by the `source` stage below.
#
# FIVE deltas from upstream, NRT deltas 3 through 7, marked in place below
# where the RUN lines differ. The two NRT deltas the 5.2 vendoring carried are
# both retired, and the reasons are worth keeping. Delta 1 defaulted ARG BASEIMAGE
# to a 22.04 tag; it is retired because the sole caller, docker/scripts/build_unreal.sh,
# always passes --build-arg BASEIMAGE explicitly and now chooses that tag per
# engine release, so a default here would be dead in the real path and would
# silently disagree with the caller in any other. Delta 2 stripped the
# ppa:slonopotamus/glibc-dso layer, which aborted on 22.04 because that PPA
# publishes no jammy suite; it is retired because upstream removed the layer
# outright on this branch. Delta 3, added 2026-08-14, swaps upstream's
# `Build.sh ... -buildubt` call for `BuildUBT.sh`, because the former does not
# publish UnrealBuildTool.dll to the path it and every later step expect it
# at, on a from-scratch clone with no prebuilt UBT to refresh in place. Delta
# 4, added 2026-08-14, changes -set:WithServer=true to =false in the
# Installed Build step, because true adds the UnrealServer target and a
# ThirdParty module it pulls in deliberately refuses to build for a Unix
# server by design, aborting the whole build. Delta 5, added 2026-08-14,
# patches the cloned Templates/TP_MotionDesignBP/TP_MotionDesignBP.uproject to
# disable its NDIMedia plugin entry, because that module logs two LogError
# lines when it cannot dlopen the proprietary libndi.so.6 (never vendored in
# the public source tree), which the DDC generation step turns into a fatal
# editor exit code even though the DDC task itself succeeds. Delta 6, added
# 2026-08-14, adds libavahi-common3 to the X11/CEF runtime library layer, to
# silence a related but non-fatal dlopen warning from the same template's
# WebRTC-based PixelStreaming plugin. Delta 7, added 2026-08-15, hardcodes the
# generated nvidia_icd.json's api_version to 1.4.312 rather than deriving it
# from the apt libvulkan1 package's own version, an unrelated number that
# happens to look similar, because UE's own bundled Vulkan loader
# unconditionally rejects any ICD manifest missing that field outright, and
# the apt-derived value, while normally present, is not a driver capability
# reading of any kind. See the RUN lines for the full account and
# context/unreal-engine-packaging.md §11.2.
#
# This file was generated by ue4-docker version 0.0.114 with the following options:
# 
# - buildgraph_args: "-set:BuildIdOverride=UE_5.4 -set:WithLinuxArm64=false -set:WithClient=true -set:WithServer=true"
# - combine: true
# - credential_mode: "secrets"
# - disable_all_patches: true
# - disable_labels: true
# - enable_dso_patch: false
# - enable_ushell: true
# - excluded_components: {"ddc": false, "debug": false, "templates": false}
# - gitdependencies_args: ""
# 
# This Dockerfile combines the steps for the following images:
# 
# - ue4-build-prerequisites
# - ue4-source
# - ue4-minimal

ARG BASEIMAGE
FROM ${BASEIMAGE} as prerequisites

# Disable interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Enable CUDA support for NVIDIA GPUs (even when not using a CUDA base image), since evidently some versions of UE unconditionally assume
# `libcuda.so.1` exists when using the NVIDIA proprietary drivers, and will fail to initialise the Vulkan RHI if it is missing
ENV NVIDIA_DRIVER_CAPABILITIES ${NVIDIA_DRIVER_CAPABILITIES},compute

# Add the "display" driver capability for NVIDIA GPUs
# (This allows us to run the Editor from an interactive container by bind-mounting the host system's X11 socket)
ENV NVIDIA_DRIVER_CAPABILITIES ${NVIDIA_DRIVER_CAPABILITIES},display

# Enable NVENC support for use by Unreal Engine plugins that depend on it (e.g. Pixel Streaming)
# (Note that adding `video` seems to implicitly enable `compute` as well, but we include separate directives here to clearly indicate the purpose of both)
ENV NVIDIA_DRIVER_CAPABILITIES ${NVIDIA_DRIVER_CAPABILITIES},video

# Install our build prerequisites
RUN apt-get update && apt-get install -y --no-install-recommends \
		build-essential \
		ca-certificates \
		curl \
		git \
		git-lfs \
		gpg-agent \
		python3 \
		python3-dev \
		python3-pip \
		shared-mime-info \
		software-properties-common \
		sudo \
		tzdata \
		unzip \
		xdg-user-dirs \
		xdg-utils \
		zip && \
	rm -rf /var/lib/apt/lists/* && echo '' && echo 'RUN directive complete. Docker will now commit the filesystem layer to disk.' && echo 'Note that for large filesystem layers this can take quite some time.' && echo 'Performing filesystem layer commit...' && echo ''

# Install the X11 runtime libraries required by CEF so we can cook Unreal Engine projects that use the WebBrowserWidget plugin
# (Starting in Unreal Engine 5.0, we need these installed before creating an Installed Build to prevent cooking failures related to loading the Quixel Bridge plugin)
#
# NRT delta 6 (2026-08-14): adds libavahi-common3. During the Installed Build's
# DerivedDataCache generation step, loading Templates/TP_MotionDesignBP logs
# "LogCore: Warning: dlopen failed: libavahi-common.so.3: cannot open shared
# object file". This is a Warning, not an Error, so by itself it does not flip
# the editor's exit code the way the NDIMedia errors do (see delta 5 below and
# LaunchEngineLoop.cpp:4163, "if ((ErrorLevel == 0) && (GWarn->GetNumErrors()
# > 0)) ErrorLevel = 1", which only counts Errors), but the package is
# genuinely absent from this list and is the standard Ubuntu package for the
# missing soname, unlike libndi.so.6, so installing it costs nothing and
# yields a warning-free build. The likely caller is the same template's
# PixelStreaming plugin, whose vendored WebRTC stack optionally resolves
# local mDNS hostnames via libavahi-client/-common on Linux; this was not
# traced to an exact call site the way the NDIMedia error was, since doing so
# would require checking out and searching the full WebRTC ThirdParty source
# tree, so it is recorded here as the most plausible explanation rather than
# a proven one.
# Superseded upstream line, kept per CLAUDE.md §2:
