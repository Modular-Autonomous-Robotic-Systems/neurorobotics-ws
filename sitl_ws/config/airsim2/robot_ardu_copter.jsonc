  "controller": {
    "id": "ArduPilot_Controller",
    "type": "ardupilot-api",
    "ardupilot-settings": {
      "local-host-ip": "127.0.0.1",
      "ardupilot-ip": "127.0.0.1",
      "ardupilot-udp-port": 9003,
      "local-host-udp-port": 9002,
      // The loader reads "use-sensor-distance" at arducopter_api.cpp:75-76
      // while the schema and every example write "use-distance-sensor", so
      // this flag can never take effect and rng.distances is always emitted
      // empty. Set false to match the absence of a distance sensor here.
      // Upstream defect G2.
      "use-distance-sensor": false,
      "actuator-order": [ 
        {
          "id": "Prop_FR_actuator"
        },
        {
          "id": "Prop_RL_actuator"
        },
        {
          "id": "Prop_FL_actuator"
        },
        {
          "id": "Prop_RR_actuator"
        }
      ]
    }
  },
  "actuators": [
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "origin": {
        "xyz": "0.253 -0.253 -0.01",
        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    },
