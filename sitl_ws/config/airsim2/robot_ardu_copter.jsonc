        "rpy-deg": "0 0 0"
      },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.109919,
        "coeff-of-torque": 0.040164,
        "max-rpm": 6396.667,
        "propeller-diameter": 0.2286,
        "smoothing-tc": 0.005
      }
    }
  ],
  "sensors": [
    {
      // Reproduces the front_center camera of the Cosys-AirSim settings.json.
      // 640x480 at 90 degrees is the exact pinhole model both SLAM configs
      // assume, since 320 / tan(45 deg) = 320. capture-interval 0.05 is a
      // nominal 20 Hz; check B3 measures what is achieved so that
      // sitl.yaml Camera.fps can be corrected from evidence.
      "id": "front_center",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.05,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 640,
          "height": 480,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": false,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 1.5
        }
      ],
      // Forward and 45 degrees down, matching X 0.50 Y 0 Z 0.10 Pitch -45 of
      // the Cosys settings.json and the extrinsics already encoded in
      // ros_ws/src/slam/ext/basalt/data/sitl_calib.json:4-12.
      "origin": {
        "xyz": "0.5 0.0 0.1",
        "rpy-deg": "0 -45 0"
      }
    },
    {
      // MPU-6000 noise figures converted from the engineering units of the
      // Cosys settings.json to the SI units Project AirSim reads directly.
      // AngularRandomWalk 2.0 deg/root-hour, GyroBiasStability 20.0 deg/hour,
      // VelocityRandomWalk 1.2 milli-g, AccelBiasStability 500 micro-g.
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      "accelerometer": {
        "velocity-random-walk": 1.176798e-2,
        "tau": 600,
        "bias-stability": 4.903325e-3,
        "turn-on-bias": "0 0 0"
      },
      "gyroscope": {
        "angle-random-walk": 5.817764e-4,
        "tau": 300,
        "bias-stability": 9.696274e-5,
        "turn-on-bias": "0 0 0"
      }
    },
    {
      "id": "GPS",
      "type": "gps",
      "enabled": true,
      "parent-link": "Frame"
    },
    {
      // Retained from the upstream example. ArduPilot's sensor fusion expects
      // both and their presence costs nothing.
      "id": "Barometer",
      "type": "barometer",
      "enabled": true,
      "parent-link": "Frame"
    },
    {
      "id": "Magnetometer",
      "type": "magnetometer",
      "enabled": true,
      "parent-link": "Frame"
    }
  ]
}
